# Copy to .env and fill in your own values. NEVER commit the actual .env.

# Required: GPT-4o-mini calls for method mining, ranking and tool synthesis
# (paid OpenAI API).
OPENAI_API_KEY=sk-...

# Required: Tavily web-search API used for retrieval (paid; 55 queries x 5 results
# per full run).
TAVILY_API_KEY=tvly-...

# Optional: only needed for the three diffusion-backed tools in WildFakeTools
# (background_realism, surface_naturalize, iterative_denoise_pass), which download
# Qwen/Qwen-Image-Edit-2511 from the Hugging Face Hub and require a CUDA GPU.
# No detector weights are downloaded by this artifact.
HUGGINGFACE_TOKEN=hf_...
HF_HOME=/path/to/your/huggingface/cache

# Optional: only used by pipeline/nodes/reddit_collector.py, a stand-alone
# collector that is NOT invoked by pipeline/pipeline.py (Reddit content is
# reached through Tavily platform-restricted searches). Create a "script" app at
# https://www.reddit.com/prefs/apps to obtain app-only, read-only credentials.
REDDIT_CLIENT_ID=...
REDDIT_CLIENT_SECRET=...
